{
  "name": "e-commerce",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/formidable": "^3.4.6",
    "@types/mime-types": "^3.0.1",
    "@types/minimist": "^1.2.5",
    "autoprefixer": "^10.5.2",
    "minimist": "^1.2.8",
    "nodemon": "^3.1.11",
    "postcss": "^8.5.16",
    "rimraf": "^6.1.2",
    "tailwindcss": "^4.3.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.0",
    "turbo": "^2.10.3"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm --filter ecommerce-monorepo exec tsc --noEmit && pnpm --filter web exec tsc -b",
    "test": "pnpm --filter ecommerce-monorepo test",
    "ci:check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.100.0",
    "antd": "^6.1.1",
    "cookie-parser": "^1.4.7",
    "jose": "^6.2.2",
    "sharp": "^0.34.5",
    "slugify": "^1.6.6"
  }
}

# Copy to apps/api/.env and fill in. Never commit the real .env.

# --- Server ---
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Extra allowed origins, comma separated
CORS_ORIGINS=

# --- MongoDB (must be a replica set: orders/payments use transactions) ---
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
DB_NAME=vibrant_mart
DB_USERS_COLLECTION=users
DB_REFRESHTOKENS_COLLECTION=refresh_tokens
DB_PRODUCTS_COLLECTION=products
DB_PRODUCT_MEDIA_COLLECTION=product_media
DB_CATEGORY_COLLECTION=categories
DB_BRANDS_COLLECTION=brands
DB_CARTS_COLLECTION=carts
DB_CART_ITEMS_COLLECTION=cart_items
DB_ORDERS_COLLECTION=orders
DB_ORDER_ITEMS_COLLECTION=order_items
DB_PAYMENTS_COLLECTION=payments
DB_DELIVERY_METHODS_COLLECTION=delivery_methods
DB_REVIEWS_COLLECTION=reviews
DB_VOUCHERS_COLLECTION=vouchers
DB_SHOP_SETTINGS_COLLECTION=shop_settings
DB_USER_ADDRESSES_COLLECTION=user_addresses

# --- Auth (use long random strings) ---
JWT_SECRET_ACCESS_TOKEN=
JWT_SECRET_REFRESH_TOKEN=
JWT_SECRET_EMAIL_VERIFY_TOKEN=
JWT_SECRET_FORGOT_PASWORD_TOKEN=
ACCESS_TOKEN_EXPIRE_IN=15m
REFRESH_TOKEN_EXPIRE_IN=100d
EMAIL_VERIFY_TOKEN_EXPIRE_IN=7d
FORGOT_PASSWORD_TOKEN_EXPIRE_IN=7d

# Google sign-in via Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Seed script (pnpm --filter ecommerce-monorepo exec ts-node src/scripts/seedAdmin.ts)
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
# At least 12 characters. Re-running the script resets this admin's password.
SEED_ADMIN_PASSWORD=

# --- Mail (Gmail app password) ---
GMAIL_USER=
GMAIL_PASS=

# --- Shipping ---
STORE_ADDRESS=
STORE_LAT=
STORE_LNG=
MAX_DELIVERY_DISTANCE_KM=25
EXPRESS_SHIPPING_SURCHARGE=
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=vibrant-mart/1.0
OSRM_BASE_URL=https://router.project-osrm.org

# --- Payments (sandbox keys in development) ---
PAYMENT_MODE=sandbox
# Only for local testing; refused in production
ENABLE_PAYMENT_MOCK=false
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:3000/payment/payos/return
PAYOS_CANCEL_URL=http://localhost:3000/payment/payos/cancel
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=
MOMO_IPN_URL=
PAYPAL_API_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_RETURN_URL=
PAYPAL_CANCEL_URL=
PAYPAL_VND_PER_USD=25000

# --- Optional integrations ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_FOLDER=
# Tùy chọn: để tự xóa ảnh/video trên Cloudinary khi admin gỡ khỏi sản phẩm (upload preset unsigned không có quyền xóa).
# Lấy ở Cloudinary Console → Settings → API Keys. Bỏ trống thì file cũ vẫn nằm trên Cloudinary.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SHOP_HOTLINE=
SHOP_ZALO_URL=
SHOP_MESSENGER_URL=
SHOP_WAREHOUSE_ADDRESS=
